{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.gannastro/schemas/sbc/source-register-v1.json",
  "title": "SBC source register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "register_id", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "register_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "authority", "content_layer", "status", "rights_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "content_layer": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "rights_status": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
          "registry_ref": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
