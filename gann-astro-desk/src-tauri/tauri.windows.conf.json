{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gann Astro Desk",
        "url": "index.html?v=0.10.16",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "resources/GannAstroBackend/": "backend/"
    }
  }
}
